// PVSim veritabanı şeması — PostgreSQL + Prisma
// NextAuth (Auth.js) modelleri + uygulama modelleri.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth / Auth.js ────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // dev credentials login için
  role          String    @default("user")
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  projects Project[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Uygulama ──────────────────────────────────────────────────
model Project {
  id             String   @id @default(cuid())
  userId         String
  name           String
  connectionType String // mesken_cati | ticari_cati | arazi | tarimsal
  latitude       Float
  longitude      Float
  // Tam FeasibilityInput JSON (esnek; motor sözleşmesi lib/simulation/types)
  inputs         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulations Simulation[]

  @@index([userId])
}

model Simulation {
  id          String   @id @default(cuid())
  projectId   String
  // Özet metrikler (listeleme/filtre için kolon)
  annualKwh   Float
  npv         Float
  irr         Float?
  lcoe        Float
  paybackYrs  Float?
  co2Tonnes   Float
  // Tam FeasibilityResult JSON
  result      Json
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Katalog tabloları (data/*.json'dan seed edilir; hesap motoru JSON okur,
// bu tablolar admin/genişletme ve UI listeleme içindir).
model Panel {
  id                   String @id
  brand                String
  model                String
  cellTech             String
  pmaxW                Float
  vmppV                Float
  imppA                Float
  vocV                 Float
  iscA                 Float
  noctC                Float
  tempCoeffPmaxPctPerC Float
  tempCoeffVocPctPerC  Float
  tempCoeffIscPctPerC  Float
  efficiency           Float
  lengthMm             Float
  widthMm              Float
  weightKg             Float
  annualDegradationPct Float
  datasheet            String
}

model Inverter {
  id               String @id
  brand            String
  model            String
  acRatedW         Float
  maxDcW           Float
  mpptCount        Int
  mpptVMinV        Float
  mpptVMaxV        Float
  maxInputCurrentA Float
  nominalEfficiency Float
  euroEfficiency   Float
  phase            String
  datasheet        String
}

model Tariff {
  category   String @id // mesken | ticarethane | sanayi | tarimsal
  timeOfUse  String
  data       Json // tam TariffStructure
  year       Int
  updatedAt  DateTime @updatedAt
}
